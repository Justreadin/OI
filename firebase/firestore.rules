rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server-side Admin SDK access bypasses these rules. Do not expose the database
    // directly to untrusted clients until Firebase Authentication and UID ownership
    // fields are implemented. Deny all client SDK access by default.
    match /{document=**} { allow read, write: if false; }
  }
}

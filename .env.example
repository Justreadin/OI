# Runtime/database selection
# Development: SQLite. Production defaults to Firestore when DATABASE_BACKEND is blank.
APP_ENV=development
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///./opportunities.db
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# AI drafting
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CLASSIFIER_MODEL=gpt-6-luna
# Optional classification during discovery. Keep false to avoid classifier API calls.
ENABLE_AI_CLASSIFICATION=false

# Discovery
SCAN_INTERVAL_MINUTES=60
ENABLE_SCHEDULER=true
MAX_JOBS_PER_SOURCE=250
BRAVE_SEARCH_API_KEY=
BRAVE_SCAN_INTERVAL_HOURS=24
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_BOARD_TOKENS=
ASHBY_BOARD_NAMES=
LEVER_SITES=
COMPANY_SEED_URLS=
ARBEITNOW_ENABLED=true
JOBICY_ENABLED=true
HIMALAYAS_ENABLED=true
WEWORKREMOTELY_ENABLED=true

# Private workspace authentication
ENABLE_BASIC_AUTH=false
APP_PASSWORD=
SECRET_KEY=

# Persistent local/private files (not Firestore document storage)
BROWSER_DATA_DIR=./browser_sessions
PLAYWRIGHT_WS_ENDPOINT=
CANDIDATE_ASSET_DIR=./candidate_assets
PREFERENCES_PATH=./data/preferences.json
CANDIDATE_PROFILE_PATH=./data/candidate_profile.json

# Gmail OAuth
GOOGLE_OAUTH_CLIENT_FILE=
GMAIL_REDIRECT_URI=
GOOGLE_OAUTH_CLIENT_CONFIG=
GMAIL_TOKEN_ENCRYPTION_KEY=
